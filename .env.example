# Anthropic-compatible API settings. Copy to .env and fill in real values.
# DeepSeek exposes an Anthropic-compatible endpoint; set its base URL here.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Model identifier accepted by the configured endpoint. No default is assumed.
LLM_MODEL=

# Optional Skill directory; defaults to the project skills/ directory.
ECHOMIND_SKILLS_DIR=

# Independent local services from compose.yml.
# Conversation memory uses Redis wm:/summary: keys and the ChromaDB
# episodic/user_profile collections; both paths are created automatically.
REDIS_URL=redis://:agentecommerce123@127.0.0.1:6380/0
REDIS_PORT=6380
REDIS_PASSWORD=agentecommerce123

CHROMA_HOST=127.0.0.1
CHROMA_PORT=8002
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Optional embedding cache; defaults to <project>/data/chroma_cache.
CHROMA_EMBEDDING_CACHE=

# Optional monitoring settings. The API layer reads these when it wires the
# monitor; leaving the webhook and Prometheus port empty disables them.
MONITOR_INTERVAL_S=10
MONITOR_WEBHOOK_URL=
MONITOR_PROMETHEUS_PORT=

# Optional evaluation storage. The baseline file is read-only; each run writes
# a new report under EVAL_REPORT_DIR.
EVAL_BASELINE_PATH=
EVAL_REPORT_DIR=
