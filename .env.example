# 模型服务：复制为.env后自行填写；示例不包含真实凭证。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
LLM_MODEL=

# 轻量零售入口。订单种子和政策由使用者显式从外部准备。
RETAIL_MODE=true
RETAIL_AGENT_MODE=multi
RETAIL_WORKFLOW_MODE=langgraph
RETAIL_LANGUAGE=zh
RETAIL_SEED_PATH=./data/retail-assets/db.json
RETAIL_POLICY_PATH=./data/retail-assets/policy.md
RETAIL_DB_PATH=./data/retail/retail.db
RETAIL_CHECKPOINT_PATH=

# 不随仓库分发知识资料、语义参考向量或模型权重。
# 轻量入口不依赖Redis、ChromaDB、Qwen或私有分类工件。
RETAIL_ENABLE_MEMORY=false
RETAIL_ENABLE_KNOWLEDGE=false
RETAIL_SEMANTIC_ROUTING=false
RETAIL_SUPPORT_ENABLED=false
RETAIL_PROFILE_ENABLED=false

# 真实模型请求前必须填写当前供应商的输入／输出每百万token人民币费率。
# 示例预算是本次新运行的硬上限，未配置费率时拒绝启动。
RETAIL_BUDGET_CNY=1
RETAIL_INPUT_CNY_PER_MTOK=
RETAIL_OUTPUT_CNY_PER_MTOK=
RETAIL_BUDGET_LEDGER=./data/retail/budget_ledger.db
RETAIL_EVENT_LOG=./data/retail/events.jsonl
RETAIL_RUN_ID=

# 可选完整资料链。自行准备匹配资料后才开启对应功能。
RETAIL_KNOWLEDGE_PATH=
RETAIL_EMBEDDING_MODEL=qwen
RETAIL_RERANKER_MODEL=qwen
RETAIL_RETRIEVAL_MODE=hybrid
RETAIL_RETRIEVAL_STRATEGY=relevance
RETAIL_SEMANTIC_MODEL_PATH=

# API和可选本地服务。保留既有容器命名及端口，避免影响已有数据卷。
API_HOST=127.0.0.1
API_PORT=8000
APP_ENV=
LOG_LEVEL=INFO
REDIS_URL=redis://:agentecommerce123@127.0.0.1:6380/0
REDIS_PORT=6380
REDIS_PASSWORD=agentecommerce123
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8002
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_EMBEDDING_CACHE=

# 可选Skills与监控。
ORDERWEAVE_SKILLS_DIR=
ORDERWEAVE_SKILLS_MAX_PROMPT_CHARS=5000
MONITOR_INTERVAL_S=10
MONITOR_WEBHOOK_URL=
MONITOR_PROMETHEUS_PORT=
EVAL_BASELINE_PATH=
EVAL_REPORT_DIR=
EVAL_JUDGE_MAX_TOKENS=4096
